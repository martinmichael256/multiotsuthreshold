image = rasterio.open("indexX.tif") 
show(image) 

# Multi-Otsu’s Thresholding Values for 3 classes 
print(image) 
image[np.isnan(image)] = np.nanmin(image) 
thresholds = threshold_multiotsu(image, classes=3) 
print(thresholds) 

# float32 to uint8 
regions = np.digitize(image, bins=thresholds) 
output = img_as_ubyte(regions) 

# Threshold Mapping 
fig, ax = plt.subplots(nrows=1, ncols=1, figsize=(10, 10.0)) 
ax.imshow(output, cmap='grey') 
ax.legend() 
